# Copy this file to .env and fill in real values. Never commit .env.
# lib/env.ts is the only place that should read process.env directly —
# every other module imports the typed `env` object from there.

# --- Core -------------------------------------------------------------

# MySQL connection string Prisma uses for all persistence, including the
# ScheduledJob queue table and the audit log.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://recover:password@localhost:3306/recover_dev"

# Secret used to sign JWT session tokens. Use a long random string
# (e.g. `openssl rand -hex 32`) — never reuse across environments.
JWT_SECRET=""

# development | production | test
NODE_ENV="development"

# Port the Next.js app listens on locally / under PM2.
PORT=3000

# --- Email channel (Brevo) ---------------------------------------------

# Brevo (formerly Sendinblue) transactional email API key. Free tier
# covers 300 emails/day. Required once Phase 6 sends real mail.
BREVO_API_KEY=""

# The "from" address Brevo sends recovery emails as. Must be a verified
# sender in your Brevo account.
BREVO_SENDER_EMAIL=""

# --- Razorpay -----------------------------------------------------------

# Razorpay API key ID, used for any authenticated Razorpay API calls.
RAZORPAY_KEY_ID=""

# Razorpay API key secret. Keep this out of client-side code entirely.
RAZORPAY_KEY_SECRET=""

# Secret used to verify the signature on incoming Razorpay webhook
# payloads (checkout drop-off / payment / subscription / invoice events).
RAZORPAY_WEBHOOK_SECRET=""

# --- Message generation (LLM drafting, optional) -------------------------

# Message generation is template-first by default and never depends on a
# paid API to function. Set to "true" to additionally route drafting
# through the Claude API behind the LLMClient interface.
USE_LLM_DRAFTING=false

# Only needed if USE_LLM_DRAFTING=true.
ANTHROPIC_API_KEY=""

# --- Internal task protection (Phase 2+) --------------------------------

# Historically a shared secret for the /api/internal/* endpoints. As of
# Phase 7 those endpoints require an ADMIN session cookie instead; this
# variable is unused by the app and kept only for backward compatibility
# with older deploy scripts. Safe to remove.
INTERNAL_TASK_SECRET=""

# --- Checkout abandonment (Phase 2) -------------------------------------

# Minutes to wait after a checkout event before treating it as abandoned.
CHECKOUT_ABANDONMENT_GRACE_MINUTES=30

# --- Orchestrator guardrails (Phase 4) -----------------------------------

# Max outbound contacts (email/SMS/WhatsApp) to a single customer in one
# calendar day. Prevents spamming on repeated failures.
MAX_CONTACTS_PER_CUSTOMER_PER_DAY=2

# Callback URL that Razorpay Payment Links redirect the customer to after
# payment. Defaults to http://localhost:PORT/api/webhooks/razorpay.
# Override in production with your public domain.
RECOVERY_CALLBACK_URL=""

# --- Human review (Phase 7) ---------------------------------------------

# Cases with amount >= this threshold (in paise) require human approval
# before sending recovery outreach. Default: ₹5,000 = 500000 paise.
HUMAN_REVIEW_AMOUNT_THRESHOLD_PAISE=500000

# --- Testing (Phase 6) --------------------------------------------------

# A real email address that receives test recovery emails during manual QA.
# Leave empty in CI / production.
TEST_RECIPIENT_EMAIL=""
